<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?xml-stylesheet type="text/xsl" href="showcase.xsl"?>
<!-- Full XML syntax sample: declaration, processing instruction, DTD, namespaces,
     attributes, entities, CDATA, comments and mixed content. -->
<!DOCTYPE catalog [
  <!ELEMENT catalog (book+, note*)>
  <!ELEMENT book (title, author+, price, description?, tags?)>
  <!ATTLIST book
      id ID #REQUIRED
      category CDATA #IMPLIED
      available (yes | no) "yes">
  <!ELEMENT title (#PCDATA)>
  <!ATTLIST title lang CDATA "en">
  <!ELEMENT author (#PCDATA)>
  <!ATTLIST author role CDATA #IMPLIED>
  <!ELEMENT price (#PCDATA)>
  <!ATTLIST price currency CDATA "USD">
  <!ELEMENT description (#PCDATA)>
  <!ELEMENT tags (tag+)>
  <!ELEMENT tag (#PCDATA)>
  <!ELEMENT note (#PCDATA)>
]>
<catalog xmlns="urn:example:catalog"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns:dc="http://purl.org/dc/elements/1.1/"
         xsi:schemaLocation="urn:example:catalog catalog.xsd">
  <book id="b1" category="fiction" available="yes">
    <title lang="en">The &amp; Escape</title>
    <dc:creator>A. Author</dc:creator>
    <author role="main">A. Author</author>
    <author>B. Author</author>
    <price currency="USD">19.99</price>
    <description><![CDATA[Raw <markup> & "quotes" are allowed here.]]></description>
    <tags>
      <tag>classic</tag>
      <tag>adventure</tag>
    </tags>
  </book>
  <book id="b2" category="reference">
    <title lang="fr">Caractères &amp; symboles</title>
    <author>Camille Écrivain</author>
    <price currency="EUR">24,50</price>
    <description>Entities: &lt; &gt; &amp; &quot; &apos; and numeric &#169; &#x1F600;.</description>
    <tags>
      <tag>reference</tag>
    </tags>
  </book>
  <note>CDATA above, comments like this one, and an xml-stylesheet instruction above.</note>
</catalog>
